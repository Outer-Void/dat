{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dat:policy:v1",
  "title": "DAT policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version"
  ],
  "properties": {
    "contract": {
      "const": "dat.policy"
    },
    "version": {
      "const": 1
    },
    "policy_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string"
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fail_on": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "min_confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "analyzers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disable": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "severity_overrides": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "enum": [
          "info",
          "low",
          "medium",
          "high",
          "critical"
        ]
      }
    },
    "suppress": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "reason"
        ],
        "minProperties": 2,
        "properties": {
          "rule_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 3
          }
        }
      }
    },
    "ignore_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "pattern": "^!"
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_files": {
          "type": "integer",
          "minimum": 1
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}

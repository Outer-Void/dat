#!/usr/bin/env python3
"""Run DAT from a checkout without installing it: ./dat audit ."""

import sys
from pathlib import Path

if sys.version_info < (3, 11):
    raise SystemExit("DAT requires Python 3.11+")
sys.path.insert(0, str(Path(__file__).resolve().parent / "src"))

from dat.cli import main  # noqa: E402

raise SystemExit(main())
